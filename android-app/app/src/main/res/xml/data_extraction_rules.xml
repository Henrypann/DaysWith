<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer each exclude the device id and the
  Room database and encrypted storage credentials under no_backup. The two sections are independent; an exclude in one does not
  apply to the other.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="pending-media/" />
        <exclude domain="database" path="archive-v3.db" />
        <exclude domain="database" path="archive-v3.db-wal" />
        <exclude domain="database" path="archive-v3.db-shm" />
        <exclude domain="database" path="archive-v3.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="pending-media/" />
        <exclude domain="database" path="archive-v3.db" />
        <exclude domain="database" path="archive-v3.db-wal" />
        <exclude domain="database" path="archive-v3.db-shm" />
        <exclude domain="database" path="archive-v3.db-journal" />
    </device-transfer>
</data-extraction-rules>
